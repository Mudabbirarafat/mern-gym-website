PORT=4000
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gym-website?retryWrites=true&w=majority

# JWT: use a long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# SMTP (e.g. a Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=you@example.com
SMTP_PASSWORD=your-app-password

# Used by createAdmin.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
